{
  "name": "sultana-inter",
  "version": "2.0.0",
  "description": "Multi-framework AI i18n migration CLI — supports Vue, React, Angular with NLLB translation",
  "main": "dist/cli.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "bin": {
    "su-inter": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Seasonley/sultana-inter.git"
  },
  "keywords": [
    "cli",
    "i18n",
    "internationalization",
    "vue",
    "react",
    "angular",
    "nllb",
    "translation",
    "migration"
  ],
  "author": "seasonley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Seasonley/sultana-inter/issues"
  },
  "homepage": "https://github.com/Seasonley/sultana-inter#readme",
  "dependencies": {
    "@angular/compiler": "^17.0.0",
    "@babel/generator": "^7.24.0",
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "@huggingface/transformers": "^3.8.1",
    "@vue/compiler-dom": "^3.4.0",
    "@vue/compiler-sfc": "^3.4.0",
    "commander": "^12.0.0",
    "micromatch": "^4.0.2",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.18.0",
    "@types/micromatch": "^4.0.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.2.0",
    "vitest": "^1.6.0"
  }
}
